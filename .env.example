# Exemple de fichier .env
# Renommez ce fichier en .env et remplissez les valeurs

DATABASE_URL=postgresql://user:password@host:5432/fermes_niayes
DATABASE_SSL=false
PORT=3000

# URL publique de l'API Express (ex: https://ferme-niayes-api.onrender.com)
# En développement local, laisser vide : le proxy Vite (/api) sera utilisé
VITE_API_URL=

# Identifiants admin — UNIQUEMENT côté serveur (variables du serveur,
# jamais compilées dans le site) : .env en local, Variables d'environnement sur Render
ADMIN_EMAIL=admin@ferme-niayes.com
ADMIN_PASSWORD=VotreMotDePasseFort